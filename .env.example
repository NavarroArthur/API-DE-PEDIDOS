MONGO_URI=mongodb://mongo:27017
MONGO_DB=ecommerce
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=pedidos.processar
RABBITMQ_DLX=pedidos.dlx
RABBITMQ_DLQ=pedidos.processar.dlq
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=pedidos.eventos
KAFKA_GROUP_AUDITORIA=auditoria
CONNECT_RETRIES=30
CONNECT_RETRY_DELAY=2.0
OUTBOX_POLL_INTERVAL=0.5
PROCESSAMENTO_DELAY=2.0
